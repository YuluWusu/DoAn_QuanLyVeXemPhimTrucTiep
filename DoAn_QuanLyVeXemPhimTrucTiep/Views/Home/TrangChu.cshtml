        <img src="https://placehold.co/1400x540/1a1a0a/ffffff?text=BANNER+PHIM+3" alt="Banner phim 3" />
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-tag"><i class="bi bi-calendar-event" style="font-size:10px"></i> Sắp ra mắt</div>
            <h1 class="hero-title">Tên Phim Nổi Bật 3</h1>
            <div class="hero-meta">
                <span class="badge-age badge-t18">T18</span>
                <span>Kinh dị</span>
                <span class="sep">·</span>
                <span>95 phút</span>
                <span class="sep">·</span>
                <span>2025</span>
            </div>
            <p class="hero-desc">Bộ phim kinh dị được mong chờ nhất năm. Đừng xem một mình!</p>
            <div class="hero-actions">
                <a href="/Booking" class="btn-primary-cv"><i class="bi bi-ticket-perforated-fill"></i> Đặt vé ngay</a>
                <a href="/Movies/Detail/3" class="btn-outline-cv"><i class="bi bi-play-circle"></i> Xem trailer</a>
            </div>
        </div>
